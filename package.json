{
  "name": "retroplaningstudio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "RetroPlaningStudio - retro-planning and design-ops studio: timeline, tasks, markdown docs, AI assistants, cloud sync and desktop builds.",
  "author": "b2renger",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:electron": "node scripts/build-electron.mjs",
    "build:all": "vite build && npm run build:electron",
    "electron:dev": "npm run build:electron && electron . --dev",
    "gen:icon": "node scripts/gen-icon.cjs",
    "verify:macsign": "node scripts/verify-mac-signature.cjs",
    "package:mac": "npm run build:all && electron-builder --mac --arm64 --x64 --publish never && node scripts/verify-mac-signature.cjs && npm run verify:launch",
    "package:win": "npm run build:all && electron-builder --win --x64 --publish never",
    "package:all": "npm run build:all && electron-builder --mac --arm64 --x64 --win --x64 --publish never && node scripts/verify-mac-signature.cjs",
    "package:dir": "npm run build:all && electron-builder --dir",
    "build:web": "vite build",
    "verify:launch": "node scripts/verify-launch.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.b2renger.retroplaningstudio",
    "productName": "RetroPlaningStudio",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "!dist/server.cjs*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronFuses": {
      "runAsNode": false,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
