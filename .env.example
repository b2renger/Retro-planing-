# Copy this file to `.env` and fill in what you need. `.env` is git-ignored; only this example is committed.

# ---------------------------------------------------------------------------
# Cloud sync (Google Drive / OneDrive) — the one-time setup
# ---------------------------------------------------------------------------
# These are the app's OWN OAuth client ids. Set them once (docs/CLOUD-SETUP.md walks through both
# consoles) and rebuild; from then on every user just clicks "Connect Google Drive" and signs in.
# Leave them empty and the app says so in Settings > Cloud sync instead of showing a dead button —
# the build still succeeds.
#
# NONE OF THESE VALUES IS A SECRET, and shipping them in the bundle is correct:
#  - a browser client id is visible in the authorize URL the moment anyone signs in;
#  - Google's own documentation states that the secret issued with an "installed"/"Desktop app"
#    client "is not treated as a secret" — it cannot be, it is compiled into every copy of the app.
#    PKCE plus the loopback redirect are what secure that flow, not the string.
# Do not "fix" this by moving them to a server. There is no server, and removing them only breaks
# one-click sign-in for every user.

# Google "Web application" client id for the browser build, or the "Desktop app" client id for the
# packaged app. Looks like 1234567890-abcdef.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Secret of the Google "Desktop app" client. Used ONLY by the packaged app's loopback code
# exchange, which Google requires it for. Optional: leave empty for a web-only build.
VITE_GOOGLE_CLIENT_SECRET=

# Microsoft Entra application (client) id. A GUID, e.g. 00000000-0000-0000-0000-000000000000.
# Microsoft public clients never use a secret, so there is no VITE_MS_CLIENT_SECRET.
VITE_MS_CLIENT_ID=

# ---------------------------------------------------------------------------
# Server (optional)
# ---------------------------------------------------------------------------
# Optional server-side Gemini key used by the dev/hosted Express server (never required for the desktop app:
# providers are configured per user in Settings > AI Providers).
GEMINI_API_KEY=
# Port for the dev/hosted server
PORT=3000
